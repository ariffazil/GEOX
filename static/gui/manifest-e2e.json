    "external_url": "https://geox.arif-fazil.com/malay_basin_workflow.html"
  },
  "arifos": {
    "required_floors": ["F1", "F2", "F4", "F7", "F9", "F11"],
    "audit_level": "standard",
    "vault_route": "999_VAULT"
  },
  "meta": {
    "author": "GEOX Platform Team",
