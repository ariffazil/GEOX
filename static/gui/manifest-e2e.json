  "icon": "https://geox.arif-fazil.com/geox-icon.svg",
  "required_tools": [
    "mcp.geox.basin",
    "mcp.geox.deep_time_state",
    "mcp.geox.seismic_compute",
    "mcp.geox.prospect",
    "mcp.geox.falsify",
    "mcp.geox.evidence"
  ],
  "ui_entry": {
    "resource_uri": "https://geox.arif-fazil.com/malay_basin_workflow.html",
    "mode": "inline-or-external",
    "capability_required": ["embedded_webview"],
    "sandbox": "allow-scripts allow-same-origin"
