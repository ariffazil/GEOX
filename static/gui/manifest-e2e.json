{
  "$schema": "https://geox.arif-fazil.com/schemas/app-manifest/v1.json",
  "app_id": "geox.malay-basin.e2e",
  "version": "1.0.0-HARDENED",
  "domain": "workflow",
  "display_name": "Malay Basin End-to-End Workflow",
