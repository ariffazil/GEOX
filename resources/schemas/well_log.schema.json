{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEOX Well Log Ingestion Contract",
  "type": "object",
  "required": ["well_id", "curves", "depth_basis"],
  "properties": {
    "well_id": { "type": "string" },
    "uwi": { "type": "string" },
    "field": { "type": "string" },
    "country_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "depth_basis": {
      "type": "string",
      "enum": ["MD", "TVD", "TVDSS"]
    },
    "depth_unit": {
      "type": "string",
      "enum": ["m", "ft"]
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mnemonic", "unit", "null_pct"],
        "properties": {
          "mnemonic": { "type": "string" },
          "canonical_alias": { "type": "string" },
          "unit": { "type": "string" },
          "null_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "depth_range_m": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
