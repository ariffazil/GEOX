{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEOX UI Event Schema",
  "description": "JSON schema for UI event validation across GEOX Earth Witness and Workbench panels",
  "type": "object",
  "required": ["event_type", "timestamp", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "artifact_selected",
        "claim_selected",
        "evidence_attached",
        "challenge_requested",
        "bbox_changed",
        "well_interval_selected",
        "seismic_slice_changed",
        "hold_acknowledged",
        "seal_requested"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "artifact_ref": { "type": "string" },
        "claim_id": { "type": "string" },
        "evidence_id": { "type": "string" },
        "challenge_text": { "type": "string" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "well_id": { "type": "string" },
        "interval": {
          "type": "object",
          "required": ["top_m", "base_m"],
          "properties": {
            "top_m": { "type": "number" },
            "base_m": { "type": "number" }
          }
        },
        "slice_index": { "type": "integer" },
        "orientation": { "type": "string", "enum": ["inline", "crossline", "timeslice"] },
        "reason": { "type": "string" },
        "mode": { "type": "string", "default": "read_only" }
      }
    }
  }
}
