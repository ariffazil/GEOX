{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GEOX Prospect Evaluation Contract",
  "type": "object",
  "required": ["prospect_name", "evaluation_mode"],
  "properties": {
    "prospect_name": { "type": "string" },
    "block": { "type": "string" },
    "country_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "evaluation_mode": {
      "type": "string",
      "enum": ["screen", "appraise", "develop"]
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_components": {
      "type": "object",
      "properties": {
        "trap": { "type": "number", "minimum": 0, "maximum": 1 },
        "reservoir": { "type": "number", "minimum": 0, "maximum": 1 },
        "charge": { "type": "number", "minimum": 0, "maximum": 1 },
        "seal": { "type": "number", "minimum": 0, "maximum": 1 },
        "timing": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "volumetrics": {
      "type": "object",
      "properties": {
        "area_km2": { "type": "number", "minimum": 0 },
        "h_m": { "type": "number", "minimum": 0 },
        "phi": { "type": "number", "minimum": 0, "maximum": 1 },
        "sw": { "type": "number", "minimum": 0, "maximum": 1 },
        "bo": { "type": "number", "minimum": 1 }
      }
    }
  }
}
