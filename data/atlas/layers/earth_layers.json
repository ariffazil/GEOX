    "structure": ["sab_faults_major", "sab_ftb", "sab_trough"],
    "stratigraphy": ["sab_crocker", "sab_trusmadi", "sab_kinabalu"],
    "petroleum": ["sab_nw_basin", "sab_faults_major", "sab_wells_public"],
    "tectonics": ["global_plate_boundaries", "global_volcanoes", "global_earthquakes"],
    "sabah_regional": ["sab_coastline", "sab_nw_basin", "sab_trough", "sab_ftb", "sab_crocker", "sab_trusmadi", "sab_kinabalu", "sab_sandakan", "sab_faults_major", "sab_wells_public"],
