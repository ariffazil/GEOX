  "style_profiles": {
    "geox_regional_clean_v1": {
      "basin_fill_opacity": 0.35,
      "fault_line_width": 1.2,
      "label_density": "medium",
      "color_scheme": "geological_standard",
      "background": "light_grey"
    },
    "geox_publication_v1": {
      "basin_fill_opacity": 0.25,
      "fault_line_width": 1.5,
      "label_density": "sparse",
      "color_scheme": "geological_standard",
      "background": "white"
    },
    "geox_dark_v1": {
      "basin_fill_opacity": 0.4,
      "fault_line_width": 1.0,
      "label_density": "medium",
      "color_scheme": "dark_adapted",
      "background": "dark_grey"
    }
  },
  "guardrails": {
    "max_bbox_degrees": 8.0,
    "max_width_px": 1600,
    "max_height_px": 1600,
    "max_layers": 12,
    "max_vector_features": 5000,
    "max_render_seconds": 20,
    "cache_ttl_seconds": 86400
  }
