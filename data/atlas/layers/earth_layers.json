{
  "$schema": "geox-earth-layers-v1",
  "version": "2026-07-01",
  "description": "GEOX Earth Layer Registry — global map layers for spatial context, interpretation, and decision support.",
  "license_note": "Natural Earth = public domain. CCOP/USGS = public. Curated layers = GEOX internal synthesis, regional scale only.",
  "truth_classes": {
    "CONTEXT": "Observable geographic fact — coastlines, bathymetry, political boundaries. No interpretation.",
    "INTERPRETATION": "Geological synthesis from public literature — basin polygons, formation boundaries, fault trends. Regional scale, not survey-grade.",
    "DECISION_SUPPORT": "Prospect-level data requiring evidence refs, QC, and human gate. Never auto-render."
  },
  "layers": [
    {
      "id": "ne_coastline",
      "name": "Global Coastline",
      "type": "vector",
      "geometry_type": "line",
      "source": "Natural Earth 10m",
      "license": "public_domain",
      "truth_class": "CONTEXT",
      "scale": "global",
      "file": "countries.geojson",
      "property_filter": {"type": "coastline"},
      "description": "World coastline from Natural Earth 10m. ~300m resolution."
    },
    {
      "id": "ne_countries",
      "name": "Country Boundaries",
      "type": "vector",
      "geometry_type": "polygon",
      "source": "Natural Earth 10m",
      "license": "public_domain",
