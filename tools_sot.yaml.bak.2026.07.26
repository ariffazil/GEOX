      read_only: true
      destructive: false
      idempotent: true
  - name: geox_deep_time_state
    domain: earth.time
    axis: observe
    lane: evidence
    access: public
    description: 'Earth State Vector through deep time: GPTS, CO2, sea level, temperature, paleogeography.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_claim
    domain: governance
    axis: reason
    lane: judgment
    access: public
    description: 'Unified claim lifecycle: create, validate, challenge, seal, evidence, consequence, optionality, cascade, feedback integrity, truth challenge.'
