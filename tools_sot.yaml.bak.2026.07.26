      read_only: true
      destructive: false
      idempotent: true
  - name: geox_geomechanics
    domain: earth.structure
    axis: compute
    lane: reasoning
    access: public
    description: 'Geomechanical analysis: bulk/shear/young modulus, poisson ratio, acoustic impedance, stress polygon.'
