organ: GEOX
version: 2026.07.18
sot_source: tools_manifest.yaml
live_port: 8081
tools:
  - name: geox_well_ingest
    domain: earth.well
    axis: observe
    lane: evidence
    access: public
    description: Load well log data from LAS, SEG-Y, DST, deviation, or tops files. Auto-detects format.
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_petrophysics
    domain: earth.petrophysics
    axis: reason
    lane: reasoning
    access: public
    description: 'Unified petrophysics: Vsh, porosity, Sw, permeability, net pay, LEM inference, QC. Modes: generate, verify, lem_inference, stoip_feed, qc.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_seismic_ingest
    domain: earth.seismic
    axis: observe
    lane: evidence
    access: public
    description: SEG-Y I/O, header inspection, export.
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_seismic_compute
    domain: earth.seismic
    axis: compute
    lane: reasoning
    access: public
    description: 'Seismic computation: forward model, well tie, attributes, wavelet extraction, inversion.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_seismic_interpret
    domain: earth.seismic
    axis: reason
    lane: reasoning
    access: public
    description: 'Unified seismic interpretation: horizon/fault picking, RSI pipeline, vision, contrast detection. Modes: horizon_contrast, fault_sticks, volume_frame, blend, rsi_pipeline, contrast, vision.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_subsurface_model
    domain: earth.model
    axis: compute
    lane: reasoning
    access: public
    description: 'Subsurface model building: joint inversion, gravity/magnetic forward, MT forward.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_basin
    domain: earth.basin
    axis: reason
    lane: reasoning
    access: public
    description: 'Unified basin intelligence: profile, resolve, macrostrat, backstrip, mass balance, thermal maturity, map context, deep time, tectonic reconstruction.'
    annotations:
      read_only: true
      destructive: false
      idempotent: true
  - name: geox_sequence
    domain: earth.stratigraphy
    axis: reason
    lane: reasoning
    access: public
    description: 'Unified stratigraphy: sequence analysis, biostratigraphic parsing and falsification. Modes: correlation, biostrat_parse, biostrat_falsify.'
