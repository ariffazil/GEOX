{
  "schema_version": "io.modelcontextprotocol/ui/1.0",
  "app_id": "geox.subsurface.well-desk",
  "name": "GEOX WellDesk",
  "version": "2026.07.24",
  "description": "1D + 2D well log viewer with multi-well correlation, GEOX-aligned petrophysics params, forward/metabolic/inverse rock physics. Explicit SYNTHETIC epistemic badges. Earth-domain coprocessor for the arifOS constitutional federation.",
  "ui_entry": {
    "type": "resource_uri",
    "resource_uri": "https://geox.arif-fazil.com/apps/well-desk/index.html"
  },
  "capabilities": {
    "events": [
      "app.initialize",
      "app.state.sync",
      "tool.request",
      "tool.result",
      "ui.action",
      "physics.result",
      "vault.seal"
    ],
    "tools": [
      "geox_well_desk",
      "geox_petrophysics",
      "geox_well_ingest",
      "geox_well_qc",
      "geox_workspace"
    ],
    "render_modes": ["1d_track", "2d_correlation", "crossplot", "forward", "inverse", "metabolic"],
    "data_classes": ["SYNTHETIC", "MEASURED", "HYBRID"],
    "petro_defaults": {
      "gr_clean": 15,
      "gr_shale": 150,
      "rw": 0.05,
      "archie_a": 1.0,
      "archie_m": 2.0,
      "archie_n": 2.0,
      "vsh_cutoff": 0.5,
      "phi_cutoff": 0.1,
      "sw_cutoff": 0.6
    }
  },
  "arifos": {
    "constitutional_federation": "geox",
    "required_floors": ["F1", "F2", "F4", "F7", "F9", "F11", "F13"],
    "physics_engine": "physics9",
    "vault_route": "999_VAULT",
    "human_judge": "888"
  },
  "fallback": {
    "chain": ["inline", "external", "card", "text"]
  },
  "_meta": {
    "ui": {
      "csp": {
        "connectDomains": ["https://geox.arif-fazil.com", "http://localhost:8081", "http://localhost:7071"],
        "resourceDomains": ["https://geox.arif-fazil.com", "'self'", "data:"],
        "frameDomains": ["'none'"],
        "baseUriDomains": ["'none'"]
      }
    }
  },
  "permissions": {
    "file_system": ["read_las", "read_lis", "write_las", "export_png"],
    "compute": ["forward_rock_physics", "inverse_rock_physics", "metabolic_convergence"],
    "network": ["vault_999_submit"]
  },
  "schemas": {
    "events": "./schemas/well_desk_event_schema.json",
    "vault_receipt": "./schemas/vault999_receipt_schema.json"
  }
}
