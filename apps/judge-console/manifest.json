{
  "schema_version": "io.modelcontextprotocol/ui/1.0",
  "app_id": "geox.ac_risk.console",
  "name": "GEOX AC_Risk Console",
  "version": "1.0.0-AAA",
  "description": "Constitutional AC risk, claim-tag evidence, prospect evaluation, and kill matrix adjudication console. Interactive Theory of Anomalous Contrast risk calculator with real-time verdict display.",
  "ui_entry": {
    "type": "resource_uri",
    "resource_uri": "https://geox.arif-fazil.com/apps/judge-console/index.html"
  },
  "capabilities": {
    "events": [
      "app.initialize",
      "app.state.sync",
      "tool.request",
      "tool.result",
      "ui.action",
      "ui.state.change",
      "ac_risk.calculated",
      "ac_risk.reset",
      "physics.result",
      "vault.seal"
    ],
    "tools": [
      "geox_claim",
      "geox_prospect",
      "geox_contrast_metabolize",
      "geox_surface_status"
    ],
    "render_modes": ["claim_graph", "kill_matrix", "ac_risk_meter", "verdict_ledger"],
    "data_classes": ["SYNTHETIC", "MEASURED", "HYBRID"]
  },
  "arifos": {
    "constitutional_federation": "geox",
    "required_floors": ["F1", "F2", "F4", "F7", "F9", "F11", "F13"],
    "physics_engine": "physics9",
    "vault_route": "999_VAULT",
    "human_judge": "888"
  },
  "fallback": {
    "chain": ["inline", "external", "card", "text"]
  },
  "_meta": {
    "ui": {
      "csp": {
        "connectDomains": ["https://geox.arif-fazil.com", "http://localhost:8081", "https://api.geox.arif-fazil.com"],
        "resourceDomains": ["https://geox.arif-fazil.com", "'self'", "data:"],
        "frameDomains": ["'none'"],
        "baseUriDomains": ["'none'"]
      }
    }
  },
  "permissions": {
    "compute": ["ac_risk_compute", "claim_graph_evaluate", "prospect_evaluate", "kill_matrix_adjudicate"],
    "network": ["vault_999_submit"]
  }
}