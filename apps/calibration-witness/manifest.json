{
  "schema_version": "io.modelcontextprotocol/ui/1.0",
  "app_id": "geox.calibration.witness",
  "name": "GEOX Calibration Witness",
  "version": "1.0.0-AAA",
  "description": "Calibration and witness registration interface for physical geoscience proxies.",
  "ui_entry": {
    "type": "resource_uri",
    "resource_uri": "ui://geox/calibration-witness"
  },
  "capabilities": {
    "events": [
      "app.initialize",
      "tool.request",
      "tool.result",
      "ui.action"
    ],
    "tools": [
      "geox_calibration_register_witness",
      "geox_list_registered_sources"
    ],
    "render_modes": ["witness_table", "calibration_curve"],
    "data_classes": ["MEASURED", "DERIVED"]
  },
  "arifos": {
    "constitutional_federation": "geox",
    "required_floors": ["F1", "F2", "F4", "F7", "F9", "F11", "F13"],
    "vault_route": "999_VAULT",
    "human_judge": "888"
  },
  "fallback": {
    "chain": ["inline", "text"]
  },
  "_meta": {
    "ui": {
      "csp": {
        "connectDomains": ["https://geox.arif-fazil.com", "http://localhost:8081"],
        "resourceDomains": ["https://geox.arif-fazil.com", "'self'", "data:"],
        "frameDomains": ["'none'"],
        "baseUriDomains": ["'none'"]
      }
    }
  }
}
