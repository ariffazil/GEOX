{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geox.os/schemas/earth/fault.json",
  "title": "Fault Schema",
  "description": "Fault stick / surface pick with throw profile and gate receipts",
  "schema_id": "fault_v1_1",
  "schema_version": "1.1.0",
  "changelog": [
    "1.1.0 - Sticks, throw_profile, tip_taper, dip, regime, gates (2026-07-23 Phase A)",
    "1.0.0 - Initial release (name+CRS only)"
  ],
  "type": "object",
  "properties": {
    "fault_id": { "type": "string" },
    "fault_name": { "type": "string" },
    "domain": {
      "type": "string",
      "enum": ["pixel", "survey_time", "survey_depth", "unknown"]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "inline": { "type": "number" },
          "xline": { "type": "number" },
          "twt_ms": { "type": "number" },
          "depth_m": { "type": "number" }
        }
      }
    },
    "throw_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "station": { "type": "number" },
          "throw": { "type": "number" },
          "throw_ms": { "type": "number" },
          "throw_m": { "type": "number" }
        }
      }
    },
    "tip_taper": {
      "type": "string",
      "enum": ["ok", "fail", "unknown"]
    },
    "dip_deg_image": { "type": ["number", "null"] },
    "dip_deg_subsurface": { "type": ["number", "null"] },
    "regime_prior": {
      "type": "string",
      "enum": ["normal", "reverse", "thrust", "strike_slip", "unknown"]
    },
    "reactivation_evidence": { "type": "boolean" },
    "max_displacement": { "type": "number" },
    "length": { "type": "number" },
    "linkage_story": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "KILL", "INCONCLUSIVE"]
      }
    },
    "coordinate": {
      "type": "object",
      "properties": {
        "crs": { "type": "string" }
      },
      "required": ["crs"]
    },
    "epistemic_label": {
      "type": "string",
      "enum": ["OBS", "DER", "INT_SEISMIC", "INT_SEISMIC_FAULT", "SPEC"]
    }
  },
  "required": ["fault_name"],
  "examples": [
    {
      "fault_id": "F1",
      "fault_name": "Fault-F1",
      "domain": "pixel",
      "regime_prior": "normal",
      "dip_deg_image": 62.0,
      "throw_profile": [
        { "station": 0, "throw": 5 },
        { "station": 1, "throw": 40 },
        { "station": 2, "throw": 8 }
      ],
      "tip_taper": "ok",
      "confidence": 0.55,
      "coordinate": { "crs": "EPSG:32631" },
      "epistemic_label": "INT_SEISMIC_FAULT"
    }
  ]
}
