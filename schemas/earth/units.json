{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geox.arif-fazil.com/schemas/earth/units.json",
  "title": "GEOX Unit Registry Schema",
  "description": "Strict enforcement of measurement units for Earth domain quantities.",
  "type": "object",
  "properties": {
    "value": {
      "type": "number",
      "description": "The numeric value of the measurement."
    },
    "unit": {
      "type": "string",
      "enum": [
        "m", "ft", 
        "m/s", "ft/s", 
        "psi", "bar", "kPa", "MPa",
        "g/cc", "kg/m3", "lbm/gal",
        "API",
        "ohm-m", "mS/m",
        "mD", "D",
        "acre-ft", "STB", "scf", "Bscf", "MMboe",
        "v/v", "%", "decimal",
        "degC", "degF",
        "gAPI",
        "unknown"
      ],
      "description": "The unit of measurement."
    },
    "measurement_type": {
      "type": "string",
      "enum": [
        "length", "velocity", "pressure", "density", "oil_gravity",
        "resistivity", "conductivity", "permeability", "volume",
        "porosity", "saturation", "temperature", "gamma_ray", "time",
        "dimensionless"
      ],
      "description": "The physical dimension of the measurement."
    },
    "conversion_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_unit": {"type": "string"},
          "to_unit": {"type": "string"},
          "factor": {"type": "number"},
          "timestamp": {"type": "string"}
        }
      },
      "description": "Audit trail if this value was converted from its native unit."
    }
  },
  "required": ["value", "unit", "measurement_type"]
}
