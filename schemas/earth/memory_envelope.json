{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://geox.arif-fazil.com/schemas/earth/memory_envelope.json",
    "title": "GEOX Canonical Memory Envelope",
    "description": "The 16-field envelope that strictly governs the promotion of claims in GEOX Earth memory.",
    "type": "object",
    "properties": {
        "id": { "type": "string" },
        "memory_type": {
            "type": "string",
            "enum": ["agent", "earth", "vault"]
        },
        "truth_class": {
            "type": "string",
            "enum": ["scratch", "observation", "interpretation", "abduction", "decision"]
        },
        "subject": { "type": "object" },
        "claim": { "type": "string" },
        "evidence": {
            "type": "array",
            "items": { "type": "object" }
        },
        "provenance": {
            "type": "object",
            "properties": {
                "source_id": { "type": "string" },
                "source_type": { "type": "string" },
                "source_hash": { "type": "string" },
                "observed_at": { "type": "string", "format": "date-time" },
                "ingested_at": { "type": "string", "format": "date-time" }
            },
            "required": ["source_id", "source_hash"]
        },
        "measurement": {
            "type": "object",
            "properties": {
                "value": {},
                "unit": { "type": ["string", "null"] },
                "datum": { "type": ["string", "null"] },
                "crs": { "type": ["string", "null"] }
            }
        },
        "uncertainty": {
            "type": "object",
            "properties": {
                "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
                "range": { "type": ["object", "string", "null"] },
                "alternatives": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["confidence"]
        },
        "authority": {
            "type": "object",
            "properties": {
                "created_by": { "type": "string" },
                "approved_by": { "type": ["string", "null"] },
                "approval_state": {
                    "type": "string",
                    "enum": ["draft", "validated", "reviewed", "sealed", "rejected"]
                }
            },
            "required": ["created_by", "approval_state"]
        },
        "freshness": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": ["fresh", "stale", "expired", "unknown"]
                },
                "valid_until": { "type": ["string", "null"], "format": "date-time" }
            }
        },
        "lineage": {
            "type": "object",
            "properties": {
                "supersedes": { "type": "array", "items": { "type": "string" } },
                "derived_from": { "type": "array", "items": { "type": "string" } }
            }
        }
    },
    "required": [
        "id",
        "memory_type",
        "truth_class",
        "claim",
        "authority"
    ],
    "allOf": [
        {
            "if": {
                "properties": { "memory_type": { "const": "earth" } }
            },
            "then": {
                "required": ["provenance", "uncertainty"]
            }
        }
    ]
}
