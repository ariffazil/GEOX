{
  "$schema": "https://json-schema.org/draft/2020-12",
  "title": "geox_seismic_load_volume — Tool Contract",
  "description": "MCP tool contract for geox_seismic_load_volume — SEG-Y ingestion tool that launches geox-seismic-viewer. DITEMPA BUKAN DIBERI",
  "version": "1.0.0",
  "tool_id": "geox_seismic_load_volume",
  "domain": "subsurface/seismic",
  "claim_tag": "OBSERVED",
  "input_schema": {
    "type": "object",
    "properties": {
      "volume_id": {
        "type": "string",
        "description": "Volume identifier for the session"
      },
      "segy_path": {
        "type": "string",
        "description": "Optional path to SEG-Y file. If omitted, uses scaffold fixture."
      },
      "inline_axis": {
        "type": "integer",
        "default": 0,
        "description": "Axis index for inline dimension"
      },
      "crossline_axis": {
        "type": "integer",
        "default": 1,
        "description": "Axis index for crossline dimension"
      },
      "sample_axis": {
        "type": "integer",
        "default": 2,
        "description": "Axis index for time/depth sample dimension"
      },
      "polarity": {
        "type": "string",
        "enum": ["SEG_NORMAL", "SEG_REVERSE", "UNKNOWN"],
        "default": "UNKNOWN",
        "description": "Amplitude polarity convention. A-POL gate returns UNMEASURED when value is UNKNOWN or when not reproducible from a well tie. Optional in this draft; promotion to required is a separate F13-bound patch."
      },
      "phase_state": {
        "type": "string",
        "enum": ["ZERO_PHASE", "MINIMUM_PHASE", "MIXED_PHASE", "UNKNOWN"],
        "default": "UNKNOWN",
        "description": "Wavelet phase state. A-PHASE gate returns UNMEASURED when UNKNOWN or when phase residual is unbounded. Optional in this draft."
      },
      "amplitude_scalar_calibration": {
        "type": "string",
        "enum": ["TRUE_AMPLITUDE", "RELATIVE_ONLY", "UNKNOWN"],
        "default": "UNKNOWN",
        "description": "Whether absolute amplitudes are calibrated and well-tied. A-SCALE gate returns UNMEASURED when not TRUE_AMPLITUDE. Optional in this draft."
      },
      "processing_vintage": {
        "type": "object",
        "properties": {
          "vintage_id": {"type": "string", "default": "UNKNOWN"},
          "vintage_start_date": {"type": "string", "default": "UNKNOWN"},
          "reprocessing_epoch": {"type": "integer", "default": 0},
          "contractor": {"type": "string", "default": "UNKNOWN"}
        },
        "default": {
          "vintage_id": "UNKNOWN",
          "vintage_start_date": "UNKNOWN",
          "reprocessing_epoch": 0,
          "contractor": "UNKNOWN"
        },
        "description": "Processing vintage identifier. A-PROV gate refuses cross-vintage amplitude claims without a mistie receipt. Optional in this draft."
      },
      "angle_ranges": {
        "type": "object",
        "properties": {
          "angle_min_deg": {"type": "number", "default": 0.0},
          "angle_max_deg": {"type": "number", "default": 0.0},
          "n_usable_stacks": {"type": "integer", "default": 0}
        },
        "default": {"angle_min_deg": 0.0, "angle_max_deg": 0.0, "n_usable_stacks": 0},
        "description": "Usable pre-stack angle range, in degrees, free of mute and NMO stretch. A-OFFSET requires declared bounds; A-AVO requires n_usable_stacks >= 3. Optional in this draft."
      }
    },
    "required": ["volume_id"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "volume_id": {"type": "string"},
      "claim_tag": {"type": "string", "enum": ["OBSERVED", "COMPUTED"]},
      "shape": {"type": "array", "items": {"type": "integer"}},
      "trace_count": {"type": "integer"},
      "inline_range": {"type": "array", "items": {"type": "integer"}},
      "crossline_range": {"type": "array", "items": {"type": "integer"}},
      "sample_range": {"type": "array", "items": {"type": "number"}},
      "ui": {
        "type": "object",
        "properties": {
          "resourceUri": {"type": "string", "const": "ui://geox_seismic_viewer"},
          "mode": {"type": "string", "const": "inline-or-external"},
          "app_id": {"type": "string", "const": "geox.seismic.viewer"},
          "version": {"type": "string", "const": "0.1.0"}
        }
      },
      "vault_receipt": {
        "type": "object",
        "properties": {
          "vault": {"type": "string", "const": "VAULT999"},
          "tool_name": {"type": "string"},
          "verdict": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"},
          "hash": {"type": "string"}
        }
      },
      "render_payload": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "const": "volume_slice"},
          "volume_id": {"type": "string"},
          "orientation": {"type": "string"},
          "slice_index": {"type": "integer"},
          "shape": {"type": "array", "items": {"type": "integer"}},
          "claim_tag": {"type": "string"}
        }
      },
      "_telemetry": {"type": "object"},
      "verdict": {"type": "string"}
    }
  },
  "arifos": {
    "floors_required": ["F1", "F2", "F4", "F7", "F9", "F11", "F13"],
    "human_in_loop": ["export_seismic", "save_horizon"],
    "vault_route": "VAULT999"
  },
  "view_type": "seismic_section",
  "mcp_apps_plane": {
    "app_id": "geox.seismic.viewer",
    "app_version": "0.1.0",
    "resource_uri": "ui://geox_seismic_viewer",
    "host_path": "/srv/mcp/apps/geox-seismic-viewer/dist/",
    "events": ["app.initialize", "app.state.sync", "seismic.slice.change", "attribute.change"]
  }
}